{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Deploy",
            "type": "shell",
            "command": "${workspaceFolder}/build-cmake.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false
            },
            "detail": "Build and deploy using build-cmake.bat"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": ".\\sil-more.exe",
            "options": {
                "cwd": "${workspaceFolder}/sil-more-windows-sdl3"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "detail": "Run from deployment folder"
        },
        {
            "label": "Run Portable",
            "type": "shell",
            "command": ".\\sil-more.exe",
            "options": {
                "cwd": "${workspaceFolder}/sil-more-windows-sdl3-portable"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "detail": "Run from portable folder"
        }
    ]
}
