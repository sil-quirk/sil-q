T:&x#:CSA:control-:shift-:alt-


###########################
#
# Shift Keypad -- Directed Running
#
# 789
# 4 6  - these run in the specified direction
# 123
#
#  5   - rest until needed

A:\a\\.1
P:^_Sx31\r

A:\a\\.2
P:^_Sx32\r

A:\a\\.3
P:^_Sx33\r

A:\a\\.4
P:^_Sx34\r

A:\a\\Z
P:^_Sx35\r

A:\a\\.6
P:^_Sx36\r

A:\a\\.7
P:^_Sx37\r

A:\a\\.8
P:^_Sx38\r

A:\a\\.9
P:^_Sx39\r




###########################
#
# Alt-Keypad -- Directed firing from the first quiver
#
# 789
# 4 6  - these fire in the specified direction
# 123
#
# 5/0   - picks the target or closest monster and fires at it

A:\a\\ff
P:^_Ax30\r

A:\a\\f1
P:^_Ax31\r

A:\a\\f2
P:^_Ax32\r

A:\a\\f3
P:^_Ax33\r

A:\a\\f4
P:^_Ax34\r

A:\a\\ff
P:^_Ax35\r

A:\a\\f6
P:^_Ax36\r

A:\a\\f7
P:^_Ax37\r

A:\a\\f8
P:^_Ax38\r

A:\a\\f9
P:^_Ax39\r



